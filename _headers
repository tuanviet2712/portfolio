/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; media-src 'self'; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  ! Access-Control-Allow-Origin

# Bộ nhớ đệm cho tệp nặng ít đổi (Cloudflare Pages mặc định chỉ 4 giờ, khiến khách quay lại phải tải lại font, khung hình hero, video).
# Font: tên tệp do Google đặt theo nội dung nên để 1 năm. Hero, khung hình, video: 7 ngày, đủ dài mà vẫn cập nhật được khi thay ảnh.
# Ảnh bìa bài viết KHÔNG đặt ở đây vì tên tệp không đổi khi nội dung đổi.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# css/js: tools/deploy.ps1 gắn ?v=<mã băm nội dung> vào mọi tham chiếu trong HTML, nội dung đổi thì địa chỉ đổi,
# nên giữ được 1 năm. Chỉ đúng khi triển khai bằng deploy.ps1 (HTML luôn tải mới với max-age=0).
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/hero/*
  Cache-Control: public, max-age=604800
/assets/frames/*
  Cache-Control: public, max-age=604800
/assets/video/*
  Cache-Control: public, max-age=604800

# CV: luôn hỏi lại máy chủ (tên tệp không đổi khi thay CV mới, mặc định 4 giờ khiến khách có thể nhận bản cũ).
# Content-Disposition: lưu về máy luôn mang đúng tên "CV_Marketing Leader_Lê Tuấn Việt.pdf" dù mở từ nút hay dán thẳng liên kết;
# inline để bấm vào liên kết vẫn xem được ngay trên trình duyệt.
/assets/cv/*
  Cache-Control: public, no-cache
  Content-Disposition: inline; filename="CV_Marketing_Leader_Le_Tuan_Viet.pdf"; filename*=UTF-8''CV_Marketing%20Leader_L%C3%AA%20Tu%E1%BA%A5n%20Vi%E1%BB%87t.pdf

# Địa chỉ pages.dev do Cloudflare tự cấp, không gỡ được: không cho Google lập chỉ mục để chỉ letuanviet.com xuất hiện.
# Dòng thứ hai là các bản xem trước của từng lần triển khai (<mã>.portfolio-elj.pages.dev).
https://portfolio-elj.pages.dev/*
  X-Robots-Tag: noindex
https://:version.portfolio-elj.pages.dev/*
  X-Robots-Tag: noindex

# Chỉ mục tìm kiếm của Góc kiến thức: chỉ dành cho ô tìm kiếm, không cho Google lập chỉ mục
/goc-kien-thuc/search.json
  X-Robots-Tag: noindex

# Toàn văn bài viết cho công cụ AI: vẫn đọc được, nhưng Google không lập chỉ mục (tránh trùng với chính các bài)
/llms-full.txt
  X-Robots-Tag: noindex
  Content-Type: text/plain; charset=utf-8

# Tệp báo lỗi bảo mật cần ở dạng văn bản thuần
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
