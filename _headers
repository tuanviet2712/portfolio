/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com https://*.g.doubleclick.net https://*.google.com https://*.google.com.vn; media-src 'self'; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net https://*.google.com https://*.google.com.vn https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  ! Access-Control-Allow-Origin

# Bộ nhớ đệm cho tệp nặng ít đổi (Cloudflare Pages mặc định chỉ 4 giờ, khiến khách quay lại phải tải lại font, khung hình hero, video).
# Font: tên tệp do Google đặt theo nội dung nên để 1 năm. Hero, khung hình, video: 7 ngày, đủ dài mà vẫn cập nhật được khi thay ảnh.
# Ảnh bìa bài viết KHÔNG đặt ở đây vì tên tệp không đổi khi nội dung đổi.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# css/js: tools/deploy.ps1 gắn ?v=<mã băm nội dung> vào mọi tham chiếu trong HTML, nội dung đổi thì địa chỉ đổi,
# nên giữ được 1 năm. Chỉ đúng khi triển khai bằng deploy.ps1 (HTML luôn tải mới với max-age=0).
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/hero/*
  Cache-Control: public, max-age=604800
/assets/frames/*
  Cache-Control: public, max-age=604800
/assets/video/*
  Cache-Control: public, max-age=604800
# Ảnh tĩnh của trang chủ (chân dung, logo, ảnh đối tác, thẻ năng lực, giá trị, lời chào): ít đổi, 7 ngày như hero.
# KHÔNG đặt cho /assets/process/*: film.js là chỉ mục byte của film.mp4 cùng tên, hai tệp bị giữ lệch phiên bản thì phim hỏng.
/assets/img/*
  Cache-Control: public, max-age=604800
/assets/hello/*
  Cache-Control: public, max-age=604800
/assets/values/*
  Cache-Control: public, max-age=604800

# CV: luôn hỏi lại máy chủ (tên tệp không đổi khi thay CV mới, mặc định 4 giờ khiến khách có thể nhận bản cũ).
# Content-Disposition: lưu về máy luôn mang đúng tên "CV_Marketing Leader_Lê Tuấn Việt.pdf" dù mở từ nút hay dán thẳng liên kết;
# inline để bấm vào liên kết vẫn xem được ngay trên trình duyệt.
/assets/cv/*
  Cache-Control: public, no-cache
  Content-Disposition: inline; filename="CV_Marketing_Leader_Le_Tuan_Viet.pdf"; filename*=UTF-8''CV_Marketing%20Leader_L%C3%AA%20Tu%E1%BA%A5n%20Vi%E1%BB%87t.pdf

# Địa chỉ pages.dev do Cloudflare tự cấp, không gỡ được: không cho Google lập chỉ mục để chỉ letuanviet.com xuất hiện.
# Dòng thứ hai là các bản xem trước của từng lần triển khai (<mã>.portfolio-elj.pages.dev).
https://portfolio-elj.pages.dev/*
  X-Robots-Tag: noindex
https://:version.portfolio-elj.pages.dev/*
  X-Robots-Tag: noindex

# Chỉ mục tìm kiếm của Góc kiến thức: chỉ dành cho ô tìm kiếm, không cho Google lập chỉ mục
/goc-kien-thuc/search.json
  X-Robots-Tag: noindex
/goc-kien-thuc/search/*
  X-Robots-Tag: noindex
# Số bài + bài mới nhất cho cột phải (js/kb.js cập nhật cột phải đóng băng của trang cũ)
/goc-kien-thuc/recent.json
  X-Robots-Tag: noindex

# Toàn văn bài viết cho công cụ AI: vẫn đọc được, nhưng Google không lập chỉ mục (tránh trùng với chính các bài)
/llms-full.txt
  X-Robots-Tag: noindex
  Content-Type: text/plain; charset=utf-8
# Phần lưu trữ của llms-full.txt (bài cũ hơn, đánh số từ bài cũ nhất): cùng quy tắc
/goc-kien-thuc/llms-full/*
  X-Robots-Tag: noindex
  Content-Type: text/plain; charset=utf-8

# Tệp báo lỗi bảo mật cần ở dạng văn bản thuần
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
